name: kg-experiments
docker_env:
  image: ghcr.io/jjfrackowiak/kg-orchestrator:latest
entry_points:
  sweep:
    parameters:
      configs:
        type: string
        default: "[]"
      n_workers:
        type: float
        default: 1
      parent_run_id:
        type: string
        default: "local"
    command: >
      python kg_builder_llm/scripts/sweep.py
      --configs '{configs}'
      --n-workers {n_workers}
      --parent-run-id {parent_run_id}
